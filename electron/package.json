{
  "name": "tutasuites-pos",
  "version": "1.0.0",
  "description": "Tuta Suites Desktop POS Terminal & Hotel Management",
  "author": "Tuta Suites",
  "main": "main.js",
  "dependencies": {},
  "build": {
    "electronVersion": "44.4.1",
    "appId": "com.tutasuites.pos",
    "productName": "Tuta Suites POS",
    "copyright": "Copyright © 2026 Tuta Suites",
    "directories": {
      "output": "../dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tuta Suites POS"
    }
  }
}
