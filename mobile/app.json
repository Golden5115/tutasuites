{
  "expo": {
    "name": "Tuta - Food & Courier",
    "slug": "tuta-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tutasuites.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "package": "com.tutasuites.app"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
