// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RoomType {
  id           String   @id @default(cuid())
  name         String   // e.g. "Deluxe", "Suite"
  slug         String   @unique // URL-friendly name e.g. "deluxe-suite"
  description  String?
  basePrice    Float
  hourlyPrice  Float?   // Fixed price for 1-hour booking
  capacity     Int
  bedType      String?  // "King Bed", "Twin Bed"
  size         String?  // "45 sqm"
  images       String[] // Array of image URLs
  facilities   String[] // ["WiFi", "AC", "Smart TV", ...]
  rules        String?  // House rules text
  cancellation String?  // Cancellation policy text
  rooms        Room[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Room {
  id           String        @id @default(cuid())
  number       String        @unique // e.g. "101", "102"
  roomTypeId   String
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  status       String        @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE, CLEANING
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Guest {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  address         String?
  country         String?
  specialRequests String?
  documentId      String?       // Passport/ID
  reservations    Reservation[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Reservation {
  id               String         @id @default(cuid())
  guestId          String
  guest            Guest          @relation(fields: [guestId], references: [id])
  roomId           String
  room             Room           @relation(fields: [roomId], references: [id])
  checkIn          DateTime
  checkOut         DateTime
  actualCheckOut   DateTime?
  numberOfGuests   Int            @default(1)
  adults           Int            @default(1)
  children         Int            @default(0)
  nights           Int            @default(1)
  bookingType      String         @default("DAILY") // DAILY or HOURLY
  valuableAssets   String?  
  status           String         @default("CONFIRMED") // PENDING, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  bookingReference String?        @unique
  roomPrice        Float          @default(0)
  taxAmount        Float          @default(0)
  serviceCharge    Float          @default(0)
  extrasAmount     Float          @default(0)
  totalAmount      Float
  paymentStatus    String         @default("UNPAID") // UNPAID, PAID, PARTIALLY_PAID, REFUNDED, FAILED
  payment          Payment?
  extras           BookingExtra[]
  barOrders        BarOrder[]
  restaurantOrders RestaurantOrder[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Payment {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String      @default("NGN")
  status        String      @default("PENDING") // PENDING, SUCCESS, FAILED
  provider      String      @default("PAYSTACK")
  reference     String      @unique
  metadata      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BookingExtra {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  quantity      Int         @default(1)
  createdAt     DateTime    @default(now())
}

model SiteSettings {
  id             String   @id @default(cuid())
  taxPercent     Float    @default(7.5)
  servicePercent Float    @default(5.0)
  currency       String   @default("NGN")
  currencySymbol String   @default("₦")
  hotelName      String   @default("Tuta Suites")
  hotelAddress   String?
  hotelPhone     String?
  hotelEmail     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  ADMIN
  FRONT_DESK
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String    
  role          Role      @default(FRONT_DESK)
  modules       String[]  
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  amount      Float
  category    String   // e.g., Utilities, Salary, Maintenance, Supplies
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LaundryCatalogItem {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     LaundryRequestItem[]
}

model LaundryRequest {
  id            String   @id @default(cuid())
  customerName  String
  roomNumber    String?
  status        String   @default("PENDING") // PENDING, WASHING, READY, DELIVERED
  paymentStatus String   @default("UNPAID") // UNPAID, PAID
  totalAmount   Float
  items         LaundryRequestItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LaundryRequestItem {
  id              String             @id @default(cuid())
  requestId       String
  request         LaundryRequest     @relation(fields: [requestId], references: [id])
  catalogItemId   String
  catalogItem     LaundryCatalogItem @relation(fields: [catalogItemId], references: [id])
  quantity        Int                @default(1)
  unitPrice       Float
  totalPrice      Float
  createdAt       DateTime           @default(now())
}

model BarItem {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Float
  stock     Int      @default(0)
  category  String   @default("Drinks")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems BarOrderItem[]
}

model BarOrder {
  id                      String           @id @default(cuid())
  customerName            String?  
  isWalkIn                Boolean          @default(true)
  reservationId           String?
  reservation             Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  status                  String           @default("COMPLETED") 
  totalAmount             Float
  items                   BarOrderItem[]
  linkedRestaurantOrderId String?
  linkedRestaurantOrder   RestaurantOrder? @relation("BarRestaurantLink", fields: [linkedRestaurantOrderId], references: [id], onDelete: SetNull)
  restaurantOrdersLinked  RestaurantOrder[] @relation("RestaurantBarLink")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model BarOrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         BarOrder @relation(fields: [orderId], references: [id])
  itemId        String
  item          BarItem  @relation(fields: [itemId], references: [id])
  quantity      Int      @default(1)
  unitPrice     Float
  totalPrice    Float
  createdAt     DateTime @default(now())
}

model RestaurantItem {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Float
  stock     Int      @default(0)
  category  String   @default("Food")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems RestaurantOrderItem[]
}

model RestaurantOrder {
  id                      String                @id @default(cuid())
  customerName            String?  
  isWalkIn                Boolean               @default(true)
  reservationId           String?
  reservation             Reservation?          @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  status                  String                @default("COMPLETED") 
  totalAmount             Float
  items                   RestaurantOrderItem[]
  linkedBarOrderId        String?
  linkedBarOrder          BarOrder?             @relation("RestaurantBarLink", fields: [linkedBarOrderId], references: [id], onDelete: SetNull)
  barOrdersLinked         BarOrder[]            @relation("BarRestaurantLink")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model RestaurantOrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         RestaurantOrder @relation(fields: [orderId], references: [id])
  itemId        String
  item          RestaurantItem  @relation(fields: [itemId], references: [id])
  quantity      Int      @default(1)
  unitPrice     Float
  totalPrice    Float
  createdAt     DateTime @default(now())
}


model GrabAndGoItem {
  id          String              @id @default(cuid())
  name        String              @unique
  price       Float
  category    String              @default("Rice")
  isAvailable Boolean             @default(true)
  stock       Int                 @default(500)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  orderItems  GrabAndGoOrderItem[]
}

model GrabAndGoOrder {
  id            String               @id @default(cuid())
  orderNumber   String               @unique
  customerId    String?
  customer      MobileCustomer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String?
  orderType     String               @default("TAKEAWAY")
  paymentMethod String               @default("CASH")
  cashierName   String?
  status        String               @default("COMPLETED")
  totalAmount   Float
  notes         String?
  items         GrabAndGoOrderItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([customerId])
}

model GrabAndGoOrderItem {
  id         String         @id @default(cuid())
  orderId    String
  order      GrabAndGoOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId     String
  item       GrabAndGoItem  @relation(fields: [itemId], references: [id])
  itemName   String
  category   String
  quantity   Int            @default(1)
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime       @default(now())
}

model MobileCustomer {
  id                  String                  @id @default(cuid())
  name                String
  phone               String                  @unique
  email               String?                 @unique
  address             String?
  passwordHash        String?
  emailVerifiedAt     DateTime?
  googleSub           String?                 @unique
  failedLoginAttempts Int                     @default(0)
  lockedUntil         DateTime?
  sessions            MobileCustomerSession[]
  orders              GrabAndGoOrder[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([email])
  @@index([phone])
  @@index([googleSub])
}

model MobileCustomerSession {
  id                String         @id @default(cuid())
  customerId        String
  customer          MobileCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refreshTokenHash  String         @unique
  previousTokenHash String?        @unique
  familyId          String
  deviceInfo        String?
  ipAddress         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?
  lastUsedAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([customerId])
  @@index([familyId])
  @@index([expiresAt])
}

model MobileOtpRecord {
  id            String    @id @default(cuid())
  identifier    String
  purpose       String    // REGISTER | PASSWORD_RESET
  otpHash       String
  payloadJson   String?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model MobileAuthRateLimit {
  key          String    @id
  count        Int       @default(1)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}
