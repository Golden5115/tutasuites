{
  "name": "tutasuites",
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "electron": "electron electron/main.js",
    "electron:dev": "electron electron/main.js --dev",
    "electron:dist": "electron-builder --win portable --x64",
    "electron:setup": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "qz-tray": "^2.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qz-tray": "^2.2.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "electron": "44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.tutasuites.pos",
    "productName": "Tuta Suites POS",
    "copyright": "Copyright © 2026 Tuta Suites",
    "asar": false,
    "files": [
      "electron/**/*",
      "!node_modules/**",
      "!src/**",
      "!.next/**",
      "!prisma/**"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tuta Suites POS"
    },
    "extraResources": [
      {
        "from": "electron/raw-printer.exe",
        "to": "raw-printer.exe"
      },
      {
        "from": "electron/thermal-logo.bin",
        "to": "thermal-logo.bin"
      }
    ]
  }
}
